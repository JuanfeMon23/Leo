# Copia este archivo a `backend/.env` (NO versionado) y reemplaza los valores.
# Valores de ejemplo, no reales. Nunca pongas secretos en otro archivo.

# Obligatoria. DSN de PostgreSQL 18 con el driver asyncpg.
DATABASE_URL=postgresql+asyncpg://USUARIO:CONTRASENA@localhost:5432/leo

# --- Semilla inicial (`uv run python -m app.core.db.seeds`) ---
# URL base del frontend de Leo (app `leo`).
LEO_FRONTEND_URL=http://localhost:3100
# Administrador inicial. Obligatorias para la semilla; si falta alguna, falla
# indicando cuales. La contrasena debe ser fuerte (>= 12 caracteres, con
# minuscula, mayuscula, digito y simbolo, sin contener el usuario).
LEO_ADMIN_USERNAME=
LEO_ADMIN_EMAIL=
LEO_ADMIN_PASSWORD=
# Uno de: CC, CE, TI, RC, PA, NIT, PEP, PPT
LEO_ADMIN_DOCUMENT_TYPE=
LEO_ADMIN_DOCUMENT_NUMBER=
# Opcionales (por defecto "Administrador" / "Leo").
LEO_ADMIN_FIRST_NAME=
LEO_ADMIN_LAST_NAME=

# --- API (uv run uvicorn app.main:app --port 8100) ---
# Todas obligatorias: si falta alguna, la API no arranca.
# URL publica de esta API (sin "/" final). Con ella se valida el `htu` de
# las pruebas DPoP: debe ser exactamente la URL que usa el navegador.
LEO_PUBLIC_URL=http://localhost:8100
# Inactividad maxima de una sesion (minutos) y vida del access token.
LEO_IDLE_TIMEOUT_MINUTES=30
LEO_ACCESS_TOKEN_MINUTES=15
# Vida absoluta maxima de una sesion SSO (horas), con o sin actividad.
LEO_SESSION_MAX_HOURS=12
# true en produccion (HTTPS): cookie Secure + prefijo __Host-. false solo en
# desarrollo local por HTTP.
LEO_COOKIE_SECURE=false
# Bloqueo tras N contrasenas incorrectas seguidas, por M minutos.
LEO_LOGIN_MAX_FAILED_ATTEMPTS=5
LEO_LOGIN_LOCK_MINUTES=1
# Intentos de login por minuto, por IP y por usuario.
LEO_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Tokens de servicio (client credentials entre apps): vida en minutos
# (tope 60) y emisiones por minuto por cliente. Opcionales (10 y 30).
LEO_SERVICE_TOKEN_MINUTES=10
LEO_SERVICE_TOKEN_RATE_LIMIT_PER_MINUTE=30
