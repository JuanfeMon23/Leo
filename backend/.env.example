# Copia este archivo a `backend/.env` (NO versionado) y reemplaza los valores.
# Valores de ejemplo, no reales. Nunca pongas secretos en otro archivo.

# Obligatoria. DSN de PostgreSQL 18 con el driver asyncpg.
DATABASE_URL=postgresql+asyncpg://USUARIO:CONTRASENA@localhost:5432/leo

# --- Semilla inicial (`uv run python -m app.core.db.seeds`) ---
# URL base del frontend de Leo (app `leo`).
LEO_FRONTEND_URL=http://localhost:3100
# Administrador inicial. Obligatorias para la semilla; si falta alguna, falla
# indicando cuales. La contrasena debe ser fuerte (>= 12 caracteres, con
# minuscula, mayuscula, digito y simbolo, sin contener el usuario).
LEO_ADMIN_USERNAME=
LEO_ADMIN_EMAIL=
LEO_ADMIN_PASSWORD=
# Uno de: CC, CE, TI, RC, PA, NIT, PEP, PPT
LEO_ADMIN_DOCUMENT_TYPE=
LEO_ADMIN_DOCUMENT_NUMBER=
# Opcionales (por defecto "Administrador" / "Leo").
LEO_ADMIN_FIRST_NAME=
LEO_ADMIN_LAST_NAME=

# --- API (uv run uvicorn app.main:app --port 8100) ---
# Todas obligatorias: si falta alguna, la API no arranca.
# URL publica de esta API (sin "/" final). Con ella se valida el `htu` de
# las pruebas DPoP: debe ser exactamente la URL que usa el navegador.
LEO_PUBLIC_URL=http://localhost:8100
# true en produccion (HTTPS): cookie Secure + prefijo __Host-. false solo en
# desarrollo local por HTTP.
LEO_COOKIE_SECURE=false
# Las politicas (inactividad, vida de tokens y sesion, bloqueo de login,
# limites de intentos, contrasenas, paginacion, export) YA NO se configuran
# aqui: se editan desde la pantalla Ajustes de Leo (tabla `settings`). Las
# variables antiguas (LEO_IDLE_TIMEOUT_MINUTES, LEO_ACCESS_TOKEN_MINUTES,
# LEO_SESSION_MAX_HOURS, LEO_LOGIN_*, LEO_SERVICE_TOKEN_*, LEO_PROVISION_*,
# LEO_DELEGATED_*) solo se leen una vez, si siguen definidas, como valor
# inicial de la clave nueva cuando aun no existe en la BD; luego se ignoran.

# --- Endurecimiento de produccion (opcionales; defaults seguros para dev) ---
# Almacen de los limites de intentos: `memory` (por proceso, solo dev) o
# `postgres` (compartido entre procesos; REQUERIDO en produccion).
LEO_RATE_LIMIT_BACKEND=memory
# IP/CIDR (separados por comas) de los proxies inversos de confianza. Solo
# desde ellos se acepta X-Forwarded-For / X-Real-IP. Vacio = se ignoran.
# Con proxy, arranca uvicorn con --no-proxy-headers.
LEO_TRUSTED_PROXIES=
# Roles de BD de minimo privilegio (backend/deploy/db_roles.sql).
# Produccion: DATABASE_URL con el rol `leo_app`; MIGRATION_DATABASE_URL con
# `leo_migrator` (solo lo usa Alembic; si falta, Alembic usa DATABASE_URL).
# MIGRATION_DATABASE_URL=postgresql+asyncpg://leo_migrator:CONTRASENA@localhost:5432/leo
